# --- Database ---
DATABASE_URL=postgresql://afdip:afdip_dev@localhost:5432/afdip

# --- Redis (BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- Object storage ---
# STORAGE_DRIVER: s3 (MinIO/S3, production) | local (filesystem, dev/CI)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# S3 settings (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=afdip
S3_SECRET_KEY=afdip_dev_secret
S3_BUCKET=afdip-files
S3_REGION=us-east-1

# --- Excel analyzer service ---
EXCEL_ANALYZER_URL=http://localhost:8100

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# --- AI layer ---
# AI_PROVIDER: anthropic | mock  (mock = deterministic outputs, no API key needed)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Public base URL of the API (OAuth redirect_uri host) — set to your domain in production
API_PUBLIC_URL=http://localhost:3001

# --- Social login (a provider activates automatically when its keys are set) ---
# Google: https://console.cloud.google.com/apis/credentials (OAuth client, Web)
#   Authorized redirect URI: {API_PUBLIC_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: https://portal.azure.com -> App registrations (supported accounts: any org + personal)
#   Redirect URI (Web): {API_PUBLIC_URL}/api/v1/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Apple: https://developer.apple.com -> Certificates, IDs & Profiles -> Services ID + Sign in with Apple key
#   Return URL: {API_PUBLIC_URL}/api/v1/auth/oauth/apple/callback (HTTPS required by Apple)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key file (escape newlines as \n)
APPLE_PRIVATE_KEY=
