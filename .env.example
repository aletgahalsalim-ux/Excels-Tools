# --- Database ---
DATABASE_URL=postgresql://afdip:afdip_dev@localhost:5432/afdip

# --- Redis (BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=afdip
S3_SECRET_KEY=afdip_dev_secret
S3_BUCKET=afdip-files
S3_REGION=us-east-1

# --- Excel analyzer service ---
EXCEL_ANALYZER_URL=http://localhost:8100

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# --- AI layer ---
# AI_PROVIDER: anthropic | mock  (mock = deterministic outputs, no API key needed)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
